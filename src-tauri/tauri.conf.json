{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Simflate",
  "version": "../package.json",
  "identifier": "app.blownsim.v2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "node scripts/check-upstream.mjs && npm run wasm && npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Simflate",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "backgroundColor": "#060708",
        "dragDropEnabled": false,
        "maximized": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Inflated stainless steel simulator",
    "longDescription": "Simflate: draw or import a flat outline, inflate it as two welded stainless sheets, and export render meshes for KeyShot and SketchUp.",
    "publisher": "Guy Armstrong",
    "category": "GraphicsAndDesign",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}