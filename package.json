{
  "name": "blownsim",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite",
    "preview": "npm run wasm && vite --open",
    "app": "npm run wasm && tauri dev",
    "build:app": "npm run wasm && tauri build",
    "suite": "cargo run --release -p blown-cli -- suite",
    "test": "cargo test --release -p blown-core -p blown-dwg && tsc --noEmit -p ui",
    "typecheck": "tsc --noEmit -p ui",
    "build:ui": "tsc --noEmit -p ui && vite build",
    "housekeeping": "node scripts/housekeeping.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "dxf-parser": "^1.1.2",
    "lucide-react": "^1.60.0",
    "meshoptimizer": "1.3.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
